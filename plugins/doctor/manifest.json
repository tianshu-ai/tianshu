{
  "id": "doctor",
  "version": "0.2.0",
  "displayName": "System Doctor",
  "description": "System diagnostics panel for maintenance mode. Runs health checks on runtime, config, providers, network, and services.",
  "decisionInstruction": "诊断系统配置和健康状态",
  "category": "runtime",
  "author": "tianshu-ai",
  "license": "Apache-2.0",
  "maintenanceOnly": true,
  "client": {
    "entry": "@tianshu-builtin/plugin-doctor/client"
  },
  "server": {
    "entry": "@tianshu-builtin/plugin-doctor/server"
  },
  "contributes": {
    "topBarButtons": [
      {
        "id": "toggle",
        "icon": "Stethoscope",
        "tooltip": "System Doctor",
        "opensPanel": "doctor.main",
        "order": 100
      }
    ],
    "rightPanels": [
      {
        "id": "main",
        "displayName": "System Doctor",
        "component": "DoctorPanel"
      }
    ],
    "apiRoutes": [
      {
        "method": "GET",
        "path": "/check",
        "handler": "getCheck"
      },
      {
        "method": "GET",
        "path": "/status",
        "handler": "getStatus"
      }
    ],
    "tools": [
      {
        "id": "audit_tool_results",
        "module": "AuditToolResultsTool",
        "since": "0.2.0"
      }
    ],
    "toolDisplay": [
      {
        "tool": "audit_tool_results",
        "input": {
          "format": "key-value",
          "pick": [
            "action",
            "messageId",
            "targetTenant"
          ],
          "labels": {
            "action": "Action",
            "messageId": "Message",
            "targetTenant": "Tenant"
          }
        },
        "output": {
          "format": "plain"
        }
      }
    ]
  }
}
