{
  "id": "image-gen",
  "version": "0.1.0",
  "displayName": "Image Generation",
  "description": "Generate images from text prompts. Pick which image-gen model to use from your configured models.",
  "category": "media",
  "author": "tianshu-ai",
  "license": "Apache-2.0",
  "permissions": ["network.external"],
  "server": { "entry": "@tianshu-builtin/plugin-image-gen/server" },
  "contributes": {
    "tools": [
      { "id": "generate_image", "module": "GenerateImageTool", "since": "0.1.0" }
    ],
    "apiRoutes": [
      { "method": "GET", "path": "/status", "handler": "getStatus" }
    ]
  },
  "configSchema": {
    "customUI": "image-gen-settings",
    "fields": [
      {
        "key": "modelId",
        "label": "Model",
        "kind": "string",
        "default": "",
        "description": "Which image-gen model to use for generate_image tool."
      },
      {
        "key": "defaultAspectRatio",
        "label": "Default Aspect Ratio",
        "kind": "select",
        "default": "1:1",
        "options": [
          { "label": "1:1 (Square)", "value": "1:1" },
          { "label": "16:9 (Landscape)", "value": "16:9" },
          { "label": "9:16 (Portrait)", "value": "9:16" },
          { "label": "4:3", "value": "4:3" },
          { "label": "3:4", "value": "3:4" }
        ]
      }
    ]
  }
}
