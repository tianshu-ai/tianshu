{
  "id": "messenger",
  "version": "0.1.0",
  "displayName": "Messenger",
  "description": "Send messages to external contacts via WeChat or WebSocket connections. The agent gets a send_message tool to push messages to configured contacts.",
  "category": "communication",
  "author": "tianshu-ai",
  "license": "MIT",
  "permissions": [
    "network.external"
  ],
  "configSchema": {
    "fields": [
      {
        "key": "publicUrl",
        "label": "Public URL",
        "kind": "string",
        "description": "This instance's public URL for tianshu peering (e.g. https://tianshu.example.com)"
      },
      {
        "key": "relayUrl",
        "label": "Relay Server URL",
        "kind": "string",
        "description": "WebSocket URL of the Agent Bluetooth relay server (e.g. wss://relay.example.com)"
      },
      {
        "key": "relayApiKey",
        "label": "Relay API Key",
        "kind": "secret",
        "description": "API key for authenticating with the relay server"
      }
    ]
  },
  "server": {
    "entry": "@tianshu-builtin/plugin-messenger/server"
  },
  "client": {
    "entry": "@tianshu-builtin/plugin-messenger/client"
  },
  "contributes": {
    "topBarButtons": [
      {
        "id": "toggle",
        "icon": "Send",
        "tooltip": "Messenger",
        "opensPanel": "messenger.main",
        "order": 450
      }
    ],
    "rightPanels": [
      {
        "id": "main",
        "displayName": "Messenger",
        "component": "MessengerPanel"
      }
    ],
    "systemPromptFragments": [
      {
        "id": "messenger-tool",
        "text": "Messenger plugin: use send_message tool to push messages to external contacts (WeChat friends, etc.).\n- send_message({to: \"name\", message: \"text\"}) sends a text message\n- send_message({to: \"name\", voice: \"text to speak\"}) sends a TTS voice message (converted to MP3)\n- send_message({to: \"name\", file: \"workspace:///path/to/file\"}) sends a file attachment\n- send_message({to: \"name\", message: \"text\", voice: \"text\", file: \"path\"}) can combine all three in one call\n- send_message({action: \"list\"}) lists all contacts\n- update_agent_card({action: \"read\"}) reads your current Agent Card\n- update_agent_card({name: \"...\", description: \"...\"}) updates your Agent Card — the public profile other agents see via A2A\nContacts are managed in the Messenger panel (top bar). When a contact is added/removed/changed, you'll receive a system notification.\nIf a channel (e.g. WeChat) is unavailable, the message will be delivered to the current chat session with a wrapper showing the original target."
      }
    ],
    "tools": [
      {
        "id": "send_message",
        "module": "SendMessageTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "messenger"
      },
      {
        "id": "update_agent_card",
        "module": "UpdateAgentCardTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "messenger"
      }
    ],
    "apiRoutes": [
      {
        "method": "POST",
        "path": "/relay/pair",
        "handler": "relayPair"
      },
      {
        "method": "GET",
        "path": "/relay/pair-requests",
        "handler": "listPairRequests"
      },
      {
        "method": "POST",
        "path": "/relay/pair-accept",
        "handler": "pairAccept"
      },
      {
        "method": "POST",
        "path": "/relay/pair-reject",
        "handler": "pairReject"
      },
      {
        "method": "POST",
        "path": "/relay/pair-dismiss",
        "handler": "pairDismiss"
      },
      {
        "method": "GET",
        "path": "/relay/discover",
        "handler": "relayDiscover"
      },
      {
        "method": "GET",
        "path": "/contacts",
        "handler": "listContacts"
      },
      {
        "method": "POST",
        "path": "/contacts",
        "handler": "createContact"
      },
      {
        "method": "PUT",
        "path": "/contacts/:id",
        "handler": "updateContact"
      },
      {
        "method": "DELETE",
        "path": "/contacts/:id",
        "handler": "deleteContact"
      },
      {
        "method": "POST",
        "path": "/contacts/:id/test",
        "handler": "testContact"
      },
      {
        "method": "GET",
        "path": "/contacts/:id/messages",
        "handler": "listMessages"
      },
      {
        "method": "POST",
        "path": "/wechat/qr/start",
        "handler": "qrStart"
      },
      {
        "method": "POST",
        "path": "/wechat/qr/poll",
        "handler": "qrPoll"
      },
      {
        "method": "POST",
        "path": "/wechat/rebind/poll",
        "handler": "rebindPoll"
      },
      {
        "method": "GET",
        "path": "/agent-card",
        "handler": "getAgentCard"
      },
      {
        "method": "PUT",
        "path": "/agent-card",
        "handler": "updateAgentCard"
      },
      {
        "method": "GET",
        "path": "/agent-card/public",
        "handler": "getAgentCardPublic",
        "auth": false
      },
      {
        "method": "POST",
        "path": "/agent-card/fetch-peer",
        "handler": "fetchPeerCard"
      },
      {
        "method": "POST",
        "path": "/a2a/token",
        "handler": "a2aToken"
      },
      {
        "method": "POST",
        "path": "/a2a/receive",
        "handler": "a2aReceive"
      },
      {
        "method": "GET",
        "path": "/.well-known/agent-card.json",
        "handler": "wellKnownAgentCard",
        "auth": false
      },
      {
        "method": "GET",
        "path": "/relay/status",
        "handler": "relayStatus"
      },
      {
        "method": "POST",
        "path": "/relay/discoverable",
        "handler": "relayDiscoverable"
      }
    ],
    "routes": []
  }
}
