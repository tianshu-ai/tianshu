{
  "id": "messenger",
  "version": "0.1.0",
  "displayName": "Messenger",
  "description": "Send messages to external contacts via WeChat or WebSocket connections. The agent gets a send_message tool to push messages to configured contacts.",
  "category": "communication",
  "author": "tianshu-ai",
  "license": "MIT",
  "permissions": ["network.external"],
  "server": { "entry": "@tianshu-builtin/plugin-messenger/server" },
  "client": { "entry": "@tianshu-builtin/plugin-messenger/client" },
  "contributes": {
    "topBarButtons": [
      {
        "id": "toggle",
        "icon": "MessageSquareShare",
        "tooltip": "Messenger",
        "opensPanel": "messenger.main",
        "order": 450
      }
    ],
    "rightPanels": [
      {
        "id": "main",
        "displayName": "Messenger",
        "component": "MessengerPanel"
      }
    ],
    "systemPromptFragments": [
      {
        "id": "messenger-tool",
        "text": "Messenger plugin: use send_message tool to push messages to external contacts (WeChat friends, etc.).\n- send_message({to: \"name\", message: \"text\"}) sends a message\n- send_message({action: \"list\"}) lists all contacts\nContacts are managed in the Messenger panel (top bar). When a contact is added/removed/changed, you'll receive a system notification."
      }
    ],
    "tools": [
      {
        "id": "send_message",
        "module": "SendMessageTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "messenger"
      }
    ],
    "apiRoutes": [
      { "method": "GET", "path": "/contacts", "handler": "listContacts" },
      { "method": "POST", "path": "/contacts", "handler": "createContact" },
      { "method": "PUT", "path": "/contacts/:id", "handler": "updateContact" },
      { "method": "DELETE", "path": "/contacts/:id", "handler": "deleteContact" },
      { "method": "POST", "path": "/contacts/:id/test", "handler": "testContact" },
      { "method": "GET", "path": "/contacts/:id/messages", "handler": "listMessages" },
      { "method": "POST", "path": "/wechat/qr/start", "handler": "qrStart" },
      { "method": "POST", "path": "/wechat/qr/poll", "handler": "qrPoll" },
      { "method": "POST", "path": "/wechat/rebind/poll", "handler": "rebindPoll" }
    ]
  }
}
