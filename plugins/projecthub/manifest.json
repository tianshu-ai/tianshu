{
  "id": "projecthub",
  "version": "0.1.0",
  "displayName": "ProjectHub",
  "description": "Cross-system project management hub — integrate with Redmine, Jira, and other issue trackers to list, create, update, and assign tasks.",
  "category": "productivity",
  "author": "tianshu-ai",
  "license": "Apache-2.0",
  "permissions": [
    "network.external"
  ],
  "server": {
    "entry": "@tianshu-builtin/plugin-projecthub/server"
  },
  "configSchema": {
    "fields": [
      {
        "key": "driver",
        "label": "Tracker Type",
        "kind": "select",
        "description": "Which project tracker to connect to",
        "options": [
          {
            "value": "redmine",
            "label": "Redmine"
          }
        ],
        "required": true
      },
      {
        "key": "baseUrl",
        "label": "Tracker URL",
        "kind": "string",
        "description": "Base URL of the project tracker (e.g. http://localhost:8890)",
        "required": true
      },
      {
        "key": "apiKey",
        "label": "API Key",
        "kind": "secret",
        "description": "API key for the project tracker",
        "required": true
      },
      {
        "key": "defaultProject",
        "label": "Default Project",
        "kind": "string",
        "description": "Default project identifier (e.g. dn-sales)"
      }
    ]
  },
  "contributes": {
    "toolGroups": [
      {
        "id": "projecthub",
        "description": "Project management hub — list, create, update, assign issues across external trackers"
      }
    ],
    "tools": [
      {
        "id": "ph_list_issues",
        "module": "ListIssuesTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "projecthub"
      },
      {
        "id": "ph_get_issue",
        "module": "GetIssueTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "projecthub"
      },
      {
        "id": "ph_create_issue",
        "module": "CreateIssueTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "projecthub"
      },
      {
        "id": "ph_update_issue",
        "module": "UpdateIssueTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "projecthub"
      },
      {
        "id": "ph_list_projects",
        "module": "ListProjectsTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "projecthub"
      },
      {
        "id": "ph_update_meta",
        "module": "UpdateMetaTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "projecthub"
      },
      {
        "id": "ph_get_project",
        "module": "GetProjectTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "projecthub"
      },
      {
        "id": "ph_create_project",
        "module": "CreateProjectTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "projecthub"
      },
      {
        "id": "ph_update_project",
        "module": "UpdateProjectTool",
        "since": "0.1.0",
        "tier": "ondemand",
        "group": "projecthub"
      }
    ],
    "apiRoutes": [
      {
        "method": "GET",
        "path": "/projects",
        "handler": "listProjects"
      },
      {
        "method": "GET",
        "path": "/projects/:id",
        "handler": "getProject"
      },
      {
        "method": "GET",
        "path": "/issues",
        "handler": "listIssues"
      },
      {
        "method": "GET",
        "path": "/issues/:id",
        "handler": "getIssue"
      }
    ],
    "systemPromptFragments": [
      {
        "id": "projecthub-tools",
        "text": "ProjectHub tools: ph_list_issues, ph_get_issue, ph_create_issue, ph_update_issue, ph_update_meta, ph_list_projects, ph_get_project, ph_create_project, ph_update_project.\nAll issue results include a `webUrl` field — always use it for links, never guess the URL.\nThese tools return rich UI cards rendered directly in the chat. ALWAYS prefer using these tools to show issue/project data — the cards are more readable than plain text. Do NOT repeat the issue details in your text response; the user already sees them in the card. Just add a brief note or answer the user's question.\nBEFORE calling ph_update_issue, ALWAYS call ph_update_meta first to check which status transitions are allowed, which fields can be changed, and what values are valid (including custom fields). The tracker may silently ignore invalid updates (e.g. forbidden status transitions return 200 but do nothing). ph_update_meta returns allowed_statuses, priorities, assignees, enabled_fields, and custom_fields with their possible_values."
      }
    ],
    "toolDisplay": [
      {
        "tool": "ph_list_issues",
        "input": {
          "format": "key-value",
          "omit": [
            "_title"
          ]
        },
        "output": {
          "format": "table"
        }
      },
      {
        "tool": "ph_get_issue",
        "input": {
          "format": "key-value",
          "omit": [
            "_title"
          ]
        },
        "output": {
          "format": "markdown"
        }
      },
      {
        "tool": "ph_create_issue",
        "input": {
          "format": "key-value",
          "omit": [
            "_title"
          ]
        },
        "output": {
          "format": "json"
        }
      },
      {
        "tool": "ph_update_issue",
        "input": {
          "format": "key-value",
          "omit": [
            "_title"
          ]
        },
        "output": {
          "format": "json"
        }
      },
      {
        "tool": "ph_list_projects",
        "input": {
          "format": "key-value",
          "omit": [
            "_title"
          ]
        },
        "output": {
          "format": "table"
        }
      }
    ],
    "topBarButtons": [
      {
        "id": "toggle",
        "icon": "FolderKanban",
        "tooltip": "Project Hub",
        "opensPanel": "projecthub.main",
        "order": 400
      }
    ],
    "rightPanels": [
      {
        "id": "main",
        "displayName": "Project Hub",
        "component": "ProjectHubPanel"
      }
    ]
  },
  "client": {
    "entry": "@tianshu-builtin/plugin-projecthub/client"
  }
}
